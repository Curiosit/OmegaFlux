# ==========================================
# Environments & Python
# ==========================================
.venv/
venv/
env/
.env
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# ==========================================
# Data & Simulation Files
# ==========================================
# Omit raw tabular files and processed extraction folders
*.csv
*.xlsx
data/processed/

# EXPLICITLY ALLOW ZIP FILES (For the deposited raw strata)
!*.zip

# Convergence-check data is small and committed (see data/convergence_check/README_convergence.md)
!data/convergence_check/*.csv
# Raw convergence re-simulations (about 1.2 MB, read by prepare_convergence_data)
!data/raw/convergence/*.xlsx

# ==========================================
# Models & ML Outputs
# ==========================================
*.joblib
*.onnx
# ...except the models the browser app ships with (GitHub Pages builds from the repository)
!apps/web/public/models/*.onnx

# Omit XGBoost JSON model files and manifests
# (Scoped to specific folders to prevent ignoring apps/web/package.json)
OmegaFlux_Models/**/*.json
models/*.json

# Temporary TreeSHAP/Training outputs
_fs_tmp.json
_sweep_tmp.json

# ==========================================
# Node.js / Web App (apps/web/)
# ==========================================
node_modules/
.npm/
npm-debug.log*

# ==========================================
# Jupyter Notebooks
# ==========================================
.ipynb_checkpoints/

# ==========================================
# IDEs & OS Generated Files
# ==========================================
.vscode/
.idea/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Python egg-info / build artifacts
# ==========================================
*.egg-info/
build/
dist/